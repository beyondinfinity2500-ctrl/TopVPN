const icon = icons[name];
const isFillIcon = ['android', 'ios', 'windows', 'macos', 'linux', 'chrome', 'router', 'star', 'paypal', 'visa', 'mastercard', 'amex', 'applepay', 'googlepay', 'crypto'].includes(name);
const w = icon.width || size;
const h = icon.height || size;
---

{icon && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={w}
    height={h}
    viewBox={icon.viewBox}
    fill={isFillIcon ? 'currentColor' : 'none'}
    class={className}
    aria-hidden="true"
    set:html={icon.svg}
  />
)}
