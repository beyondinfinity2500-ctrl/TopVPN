  applepay: { svg: '<rect width="36" height="24" rx="3" fill="#000"/><text x="18" y="16" text-anchor="middle" fill="#fff" font-family="Arial" font-size="7" font-weight="bold">Pay</text>', viewBox: '0 0 36 24', width: 36, height: 24 },
  googlepay: { svg: '<rect width="36" height="24" rx="3" fill="#fff"/><text x="18" y="16" text-anchor="middle" fill="#4285F4" font-family="Arial" font-size="7" font-weight="bold">G Pay</text>', viewBox: '0 0 36 24', width: 36, height: 24 },
  crypto: { svg: '<rect width="36" height="24" rx="3" fill="#F7931A"/><text x="18" y="17" text-anchor="middle" fill="#fff" font-family="Arial" font-size="10" font-weight="bold">BTC</text>', viewBox: '0 0 36 24', width: 36, height: 24 },
