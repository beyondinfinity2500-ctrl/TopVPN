---
import Logo from './Logo.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: '/order-vpn' },
  { label: 'Guides', href: '/vpn-types-guide' },
  { label: 'Articles', href: '/articles' },
  { label: 'Advertise', href: '/advertise' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/index$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// Language switcher. Only the homepage and About page exist in every language;
// on other pages each option points at that language's homepage.
const path = (currentPath.replace(/\/+$/, '') || '/');
let currentLang = 'en';
let page = path;
if (path === '/ar' || path.startsWith('/ar/')) {
  currentLang = 'ar';
  page = path.slice(3) || '/';
} else if (path === '/pcm' || path.startsWith('/pcm/')) {
  currentLang = 'pcm';
  page = path.slice(4) || '/';
}

const hasTranslation = page === '/' || page === '/about';
const langHref = (lang: string) => {
  const target = hasTranslation ? page : '/';
  if (lang === 'en') return target;
  return `/${lang}${target === '/' ? '' : target}`;
};

const languages = [
  { code: 'en', label: 'English', href: langHref('en') },
  { code: 'ar', label: 'العربية', href: langHref('ar') },
  { code: 'pcm', label: 'Pidgin', href: langHref('pcm') },
];

const selectStyle =
  'background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text); border-radius: 0.5rem; padding: 0.35rem 0.5rem; font-size: 0.8rem; min-height: 40px;';
---

<header class="sticky top-0 z-50" style="background: var(--color-bg); border-bottom: 1px solid var(--color-border); backdrop-filter: blur(12px);">
  <div class="container-max flex items-center justify-between" style="height: var(--header-h);">
    <a href="/" aria-label="TopVPN home" class="flex items-center" style="min-height: 44px;">
      <Logo width={32} height={32} />
    </a>

    <nav class="hidden md:flex items-center gap-4" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors',
            isActive(link.href) ? 'gold-text' : '',
          ]}
          style={isActive(link.href) ? '' : 'color: var(--color-muted);'}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <label class="sr-only" for="lang-desktop">Language</label>
      <select id="lang-desktop" class="lang-select" aria-label="Language" style={selectStyle}>
        {languages.map((l) => (
          <option value={l.href} selected={l.code === currentLang}>{l.label}</option>
        ))}
      </select>

      <a href="/#plans" class="btn-gold text-sm" style="min-height: 40px; padding: 0.5rem 1.25rem;">View Plans</a>
    </nav>

    <button
      type="button"
      class="md:hidden flex items-center justify-center"
      style="min-width: 44px; min-height: 44px; color: var(--color-text);"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="menu-toggle"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="menu-icon" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="close-icon" class="hidden" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden" style="background: var(--color-bg-alt); border-top: 1px solid var(--color-border);">
    <nav class="container-max flex flex-col gap-1 py-3" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-3 text-sm font-medium rounded-lg transition-colors',
            isActive(link.href) ? 'gold-text' : '',
          ]}
          style={isActive(link.href) ? '' : 'color: var(--color-muted);'}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <label class="sr-only" for="lang-mobile">Language</label>
      <select id="lang-mobile" class="lang-select mx-3 my-2" aria-label="Language" style={selectStyle}>
        {languages.map((l) => (
          <option value={l.href} selected={l.code === currentLang}>{l.label}</option>
        ))}
      </select>

      <a href="/#plans" class="btn-gold text-sm mt-2 mx-3">View Our Plans</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  document.querySelectorAll('select.lang-select').forEach((select) => {
    select.addEventListener('change', () => {
      window.location.href = (select as HTMLSelectElement).value;
    });
  });
</script>
