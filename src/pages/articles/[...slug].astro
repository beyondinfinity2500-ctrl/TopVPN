---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    // entry.body is typed string | undefined in Astro 5's glob loader; render()
    // requires a string, so coalesce here to keep the page typed cleanly.
    props: { entry, rawBody: entry.body ?? '' },
  }));
}

const { entry, rawBody } = Astro.props;
const { Content, headings } = await render(entry);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const related: { title: string; href: string; reason: string }[] = allArticles
  .filter((a) => a.id !== entry.id)
  .slice(0, 3)
  .map((a) => ({
    // entry.id is typed string | undefined in Astro 5's glob loader; every
    // article here has already been routed, so both are present at build time.
    title: String(a.data.title),
    href: `/articles/${String(a.id)}`,
    reason: String(a.data.reason || a.data.description),
  }));
---

<ArticleLayout entry={entry} headings={headings ?? []} related={related} body={rawBody}>
  <Content />
</ArticleLayout>
