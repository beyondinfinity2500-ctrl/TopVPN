---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TagChips from '../components/TagChips.astro';
import Icons from '../components/Icons.astro';
import NewsiqAd from '../components/newsiq/NewsiqAd.astro';
import { newsiqInline } from '../data/newsiq-ads';
import { breadcrumbSchema, faqSchema, contextWrapper } from '../lib/schema';

const updatedStr = 'November 2026';

const platforms = [
  { icon: 'windows', name: 'Windows', suits: 'Most desktop users — full-featured apps with settings for protocols, kill switch, and split tunneling' },
  { icon: 'macos', name: 'macOS', suits: 'Apple desktop and laptop users — native apps with menu-bar quick connect' },
  { icon: 'linux', name: 'Linux', suits: 'Power users and developers — command-line tools and some GUI clients; open-source options available' },
  { icon: 'android', name: 'Android', suits: 'Phone and tablet users — quick-toggle widget, auto-connect on untrusted Wi-Fi' },
  { icon: 'ios', name: 'iOS', suits: 'iPhone and iPad users — seamless on/off toggle, integrates with Apple privacy features' },
  { icon: 'router', name: 'Routers', suits: 'Households wanting every device protected without installing apps — covers smart TVs and game consoles' },
  { icon: 'chrome', name: 'Browser extensions', suits: 'Lightweight browsing privacy — only protects browser traffic, not other apps' },
];

const openSourceClients = [
  { name: 'WireGuard', description: 'The official WireGuard client — available on multiple platforms, fast and minimal.' },
  { name: 'OpenVPN Connect', description: 'The official client for OpenVPN — works on Windows, macOS, Android, and iOS.' },
  { name: 'v2rayN', description: 'A Windows client for V2Ray — popular in regions where standard VPN protocols are blocked.' },
  { name: 'Hiddify', description: 'A cross-platform client that supports multiple protocols including Shadowsocks and V2Ray.' },
];

/**
 * Branded TopVPN installers (white-label). Files live on OUR host under
 * /downloads/ with the exact names below. A button renders only when the file
 * exists at build time — drop the installer into public/downloads/ with the
 * listed name, rebuild, and it goes live. No dead links, ever.
 */
const brandedApps = [
  {
    platform: 'Windows', icon: 'windows', file: 'TOPVPN.TOP-Windows.exe',
    label: 'TopVPN for Windows', how: 'Full-featured desktop client with system tray integration, kill switch and auto-connect.',
    protocols: ['OpenVPN UDP/TCP', 'IKEv2', 'WireGuard', 'L2TP', 'PPTP', 'Stealth'],
  },
  {
    platform: 'macOS', icon: 'macos', file: 'TOPVPN.TOPApple-Mac.dmg',
    label: 'TopVPN for macOS', how: 'Native macOS app with clean interface, menu bar integration and one-click connect.',
    protocols: ['OpenVPN UDP/TCP', 'IKEv2', 'WireGuard', 'L2TP', 'PPTP', 'Stealth'],
  },
  {
    platform: 'Linux', icon: 'linux', file: 'TOPVPN.TOP-Linux.run',
    label: 'TopVPN for Linux', how: 'Native GUI client for Ubuntu and other Linux distributions. Lightweight and fast.',
    protocols: ['OpenVPN UDP/TCP', 'WireGuard'],
  },
  {
    platform: 'Firestick & Android TV', icon: 'android', file: 'TOPVPN.TOPFirestick-Android_TV.apk',
    label: 'TopVPN for Firestick & Android TV', how: 'White-label VPN app for Amazon Firestick and Android TVs, designed for big screens with a remote-friendly interface. Smart TV support.',
    protocols: ['OpenVPN UDP/TCP'],
  },
];

/** Store-distributed apps — links, not files on our host. */
const storeApps = [
  {
    platform: 'Android', icon: 'android', label: 'TopVPN for Android',
    how: 'Phone and tablet app with quick-toggle widget and auto-connect on untrusted Wi-Fi. Install straight from Google Play.',
    storeName: 'Get it on Google Play', storeUrl: 'https://play.google.com/store/apps/details?id=com.vpn.client&pli=1',
  },
  {
    platform: 'iOS', icon: 'ios', label: 'TopVPN for iPhone & iPad',
    how: 'Seamless on/off toggle with Apple-native feel. Install straight from the App Store.',
    storeName: 'Download on the App Store', storeUrl: 'https://apps.apple.com/us/app/vpnclient-secured-vpn/id1506797696',
  },
];

const fs = await import('node:fs');
const brandedAvailable = brandedApps.map((app) => {
  let exists = false;
  let sizeMb: string | null = null;
  try {
    const stat = fs.statSync(new URL(`../../public/downloads/${app.file}`, import.meta.url));
    exists = stat.isFile();
    sizeMb = (stat.size / (1024 * 1024)).toFixed(1);
  } catch {
    /* installer not uploaded yet */
  }
  return { ...app, exists, sizeMb };
});
const anyBranded = brandedAvailable.some((a) => a.exists);

const leakTestSteps = [
  { step: 1, title: 'Note your real IP address', text: 'Before connecting the VPN, visit a site like whatismyipaddress.com and write down your IP.' },
  { step: 2, title: 'Connect your VPN', text: 'Open your VPN app and connect to a server in any country.' },
  { step: 3, title: 'Check your IP again', text: 'Reload the same site. The IP should now show the VPN server country, not your real location.' },
  { step: 4, title: 'Run a DNS leak test', text: 'Visit dnsleaktest.com and run the extended test. All DNS servers should belong to your VPN provider, not your ISP.' },
  { step: 5, title: 'Disconnect and verify', text: 'Turn off the VPN and reload the page. Your real IP should return. If it does not, there may be a connection issue.' },
];

const faqs = [
  { question: 'How do I download the TopVPN app?', answer: 'Scroll to the TopVPN Apps section above and pick your platform — Windows, macOS, Linux, Firestick/Android TV, Android (Google Play) or iOS (App Store). Install, sign in with your TopVPN account, and connect. One subscription covers every platform.' },
  { question: 'Is the TopVPN download free?', answer: 'The app itself is free to download and install on every platform. You need an active TopVPN plan to connect to servers — plans start at $3 for your first month.' },
  { question: 'Do I need to install a VPN on every device separately?', answer: 'Yes, for full protection you need the VPN app on each device you use. Alternatively, you can install the VPN on your router to cover all devices on your home network, including smart TVs and game consoles.' },
  { question: 'Can I use a VPN on my smart TV or Firestick?', answer: 'Yes — the TopVPN app for Firestick & Android TV is built for big screens with a remote-friendly interface. If your TV does not support the app, install the VPN on your router instead.' },
  { question: 'Does a browser extension protect my whole computer?', answer: 'No. A browser extension only encrypts traffic from your browser. Other apps on your device — email, games, system updates — still use your real connection. For full protection, use the VPN app.' },
];

const tags = ['vpn download', 'apps', 'devices', 'Windows', 'macOS', 'Android', 'iOS', 'Linux', 'Firestick', 'guide'];
---

<BaseLayout
  title="VPN Download — TopVPN Apps for Windows, Mac, Android, iOS, Linux & Firestick"
  description="Free VPN download for every device: the official TopVPN app for Windows, macOS, Linux, Android, iPhone and Firestick. One-click install, kill switch, WireGuard and OpenVPN support. Plans from $3 first month."
  keywords="vpn download, download vpn, free vpn download, vpn for windows, vpn for android, vpn for pc, vpn app download, topvpn download, vpn for mac, vpn for firestick, vpn for linux, wireguard download, openvpn download, iphone vpn, download vpn for windows 10"
  jsonLd={contextWrapper([breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Apps' }]), faqSchema(faqs)])}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Apps' }]} />

  <section class="container-max py-8 md:py-12">
    <div class="max-w-3xl">
      <div class="mb-4 flex items-center gap-2 text-xs" style="color: var(--color-muted-dark);">
        <Icons name="doc" size={14} />
        <span>Updated {updatedStr}</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">
        VPN Download — Official TopVPN Apps <span class="gold-text">for Every Device</span>
      </h1>

      <p class="text-base md:text-lg mb-4" style="color: var(--color-muted);">
        Looking for a fast VPN download? Get the official TopVPN app below for Windows, macOS, Linux, Android, iPhone/iPad, or Firestick. Every installer is served straight from our own servers and signed by our VPN infrastructure partner — one subscription covers all your devices.
      </p>

      <div class="card p-4 mb-6 text-sm" style="background: var(--color-bg-alt);">
        <p style="color: var(--color-muted);"><strong style="color: var(--color-text);">Quick answer:</strong> Install the VPN app on every phone, laptop, and tablet you use. For smart TVs and game consoles, set up the VPN on your router instead. VPN laws differ by country — check local rules before use.</p>
      </div>

      <TagChips chips={tags} class="mb-6" />
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">TopVPN Apps — Official Download</h2>
    <p class="text-sm mb-4 max-w-3xl" style="color: var(--color-muted);">
      Download the official TopVPN app for your device. Sign in with your TopVPN account, and connect — your server list and configuration are pulled automatically.
    </p>

    {anyBranded && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4 max-w-5xl">
        {brandedAvailable.filter((a) => a.exists).map((a) => (
          <div class="card p-5 flex flex-col">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-3 shrink-0" style="background: linear-gradient(135deg, rgba(212,175,55,0.18), rgba(212,175,55,0.06));">
              <Icons name={a.icon} size={26} class="text-amber-400" />
            </div>
            <h3 class="text-base font-bold mb-1" style="font-family: var(--font-heading);">{a.label}</h3>
            <p class="text-xs mb-3 flex-grow" style="color: var(--color-muted);">{a.how}</p>
            <div class="flex flex-wrap gap-1 mb-3">
              {a.protocols.map((p) => (
                <span class="text-[10px] px-2 py-0.5 rounded-full" style="background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-muted);">{p}</span>
              ))}
            </div>
            <a href={`/downloads/${a.file}`} download class="btn-gold w-full justify-center text-sm" rel="nofollow">Download for {a.platform}</a>
            <p class="text-[10px] mt-2 text-center" style="color: var(--color-muted-dark);">{a.file} · {a.sizeMb} MB</p>
          </div>
        ))}
      </div>
    )}

    <div class={`grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 max-w-3xl ${anyBranded ? '' : 'mt-6'}`}>
      {storeApps.map((a) => (
        <div class="card p-5 flex flex-col">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-3 shrink-0" style="background: linear-gradient(135deg, rgba(212,175,55,0.18), rgba(212,175,55,0.06));">
            <Icons name={a.icon} size={26} class="text-amber-400" />
          </div>
          <h3 class="text-base font-bold mb-1" style="font-family: var(--font-heading);">{a.label}</h3>
          <p class="text-xs mb-4 flex-grow" style="color: var(--color-muted);">{a.how}</p>
          <a href={a.storeUrl} target="_blank" rel="nofollow noopener" class="btn-gold w-full justify-center text-sm">{a.storeName}</a>
        </div>
      ))}
    </div>

    <p class="text-xs mb-8 max-w-3xl" style="color: var(--color-muted-dark);">
      All downloads are served directly from TopVPN's own servers. One subscription covers every platform — <a href="/order-vpn" class="gold-text underline">see plans</a>.
    </p>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Apps by Platform</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 max-w-4xl">
      {platforms.map((p) => (
        <div class="card p-5 flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: rgba(212, 175, 55, 0.1);">
            <Icons name={p.icon} size={20} class="text-amber-400" />
          </div>
          <div>
            <h3 class="text-base font-bold mb-1" style="font-family: var(--font-heading);">{p.name}</h3>
            <p class="text-sm" style="color: var(--color-muted);">{p.suits}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Open-Source Clients</h2>
    <p class="text-sm mb-4 max-w-3xl" style="color: var(--color-muted);">
      Some VPN protocols have open-source client software you can use independently. These are generally well-maintained and auditable, but availability varies by platform and you still need a server to connect to.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 max-w-4xl">
      {openSourceClients.map((c) => (
        <div class="card p-4">
          <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">{c.name}</h3>
          <p class="text-xs" style="color: var(--color-muted);">{c.description}</p>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">How to Check Your VPN Works</h2>
    <p class="text-sm mb-4 max-w-3xl" style="color: var(--color-muted);">
      After setting up your VPN, run a quick IP and DNS leak test to confirm your traffic is actually going through the VPN.
    </p>
    <div class="space-y-3 mb-8 max-w-3xl">
      {leakTestSteps.map((s) => (
        <div class="card p-4 flex items-start gap-4">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold shrink-0" style="background: linear-gradient(135deg, #D4AF37, #F5D77A); color: #0B1020;">{s.step}</span>
          <div>
            <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">{s.title}</h3>
            <p class="text-xs" style="color: var(--color-muted);">{s.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="my-10">
      <NewsiqAd placement={newsiqInline} id="newsiq-guide-apps" />
    </div>

    <div class="max-w-3xl mb-8">
      <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">FAQ</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-4 group">
            <summary class="font-semibold cursor-pointer text-sm flex items-center justify-between" style="font-family: var(--font-heading);">
              {f.question}
              <Icons name="chevron-down" size={16} class="text-amber-400 transition-transform group-open:rotate-180" />
            </summary>
            <p class="text-sm mt-3" style="color: var(--color-muted);">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Related Guides</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl">
      <a href="/connection-guide" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">VPN Protocols Explained</h3>
        <p class="text-xs" style="color: var(--color-muted);">WireGuard, OpenVPN, V2Ray, and Shadowsocks compared</p>
      </a>
      <a href="/order-vpn" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">Compare VPN Plans</h3>
        <p class="text-xs" style="color: var(--color-muted);">See which providers offer apps for your devices</p>
      </a>
      <a href="/" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">TopVPN Home</h3>
        <p class="text-xs" style="color: var(--color-muted);">Our top recommendations and why we picked them</p>
      </a>
    </div>
  </section>
</BaseLayout>
