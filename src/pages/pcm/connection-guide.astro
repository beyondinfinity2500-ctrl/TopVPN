---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagChips from '../../components/TagChips.astro';
import Icons from '../../components/Icons.astro';
import NewsiqAd from '../../components/newsiq/NewsiqAd.astro';
import { newsiqInline } from '../../data/newsiq-ads';
import { breadcrumbSchema, contextWrapper } from '../../lib/schema';

const updatedStr = 'October 2026';

const protocolSituations = [
  { situation: 'Everyday browsing and streaming', recommendation: 'WireGuard', reason: 'Fastest, modern encryption, low overhead' },
  { situation: 'Networks wey dey block WireGuard', recommendation: 'OpenVPN (UDP)', reason: 'Reliable fallback, e dey supported wide' },
  { situation: 'Restrictive firewalls', recommendation: 'OpenVPN (TCP)', reason: 'E slower but e dey pass firewalls better' },
  { situation: 'Mobile and on-the-go', recommendation: 'IKEv2/IPSec', reason: 'E dey reconnect quick when you switch network' },
  { situation: 'Networks wey dem block everything', recommendation: 'Shadowsocks or V2Ray', reason: 'Dem design am to disguise traffic as normal HTTPS' },
  { situation: 'Maximum speed on trusted devices', recommendation: 'WireGuard', reason: 'Lean codebase, minimal latency' },
];

const countryProtocols = [
  { country: 'China', pop: '1.1B+', oftenWorks: 'Shadowsocks, V2Ray', mayBeBlocked: 'WireGuard, OpenVPN', note: 'Deep packet inspection dey target standard VPN traffic; obfuscation tools dey often work better' },
  { country: 'India', pop: '700M+', oftenWorks: 'WireGuard, OpenVPN', mayBeBlocked: 'Shadowsocks (rarely needed)', note: 'Standard protocols dey usually work; occasional throttling on some networks' },
  { country: 'United States', pop: '310M+', oftenWorks: 'WireGuard, OpenVPN, IKEv2', mayBeBlocked: 'V2Ray (rarely needed)', note: 'All standard protocols dey work free' },
  { country: 'Indonesia', pop: '210M+', oftenWorks: 'WireGuard, OpenVPN', mayBeBlocked: 'Some servers on mobile networks', note: 'Occasional restrictions on gaming and social traffic' },
  { country: 'Brazil', pop: '180M+', oftenWorks: 'WireGuard, OpenVPN', mayBeBlocked: 'IKEv2 (uncommon)', note: 'Standard protocols dey generally work without wahala' },
  { country: 'Turkey', pop: '80M+', oftenWorks: 'OpenVPN (TCP), Shadowsocks', mayBeBlocked: 'WireGuard (intermittent)', note: 'Dem dey throttle time to time; TCP-based protocols dey often more reliable' },
  { country: 'Russia', pop: '130M+', oftenWorks: 'Shadowsocks, V2Ray, OpenVPN (TCP)', mayBeBlocked: 'WireGuard, OpenVPN (UDP)', note: 'Dem dey actively block standard VPN protocols; obfuscation recommended' },
  { country: 'Iran', pop: '90M+', oftenWorks: 'Shadowsocks, V2Ray', mayBeBlocked: 'WireGuard, OpenVPN, IKEv2', note: 'Heavy filtering dey happen; obfuscation tools dey typically necessary' },
];

const protocols = [
  {
    name: 'WireGuard',
    badge: 'Fastest',
    description: 'The newest mainstream protocol. E use modern cryptography and lean codebase, wey make am fast and easy to audit. Best for everyday use.',
    bestFor: 'Streaming, browsing, mobile data',
  },
  {
    name: 'OpenVPN (UDP)',
    badge: 'Reliable',
    description: 'Battle-tested open-source protocol. The UDP variant prioritize speed. Good fallback when WireGuard block or unstable on your network.',
    bestFor: 'Fallback when WireGuard no dey work',
  },
  {
    name: 'OpenVPN (TCP)',
    badge: 'Stealthy',
    description: 'Same encryption as UDP but over TCP, wey dey tolerate unstable connection more. E slower, but e fit pass through firewalls wey dey drop UDP.',
    bestFor: 'Restrictive networks and firewalls',
  },
  {
    name: 'IKEv2/IPSec',
    badge: 'Mobile-friendly',
    description: 'Dem build am inside most phones natively. E dey reconnect quick when you switch between Wi-Fi and cellular, so e ideal for mobile use.',
    bestFor: 'Phones, tablets, on-the-go',
  },
  {
    name: 'Shadowsocks',
    badge: 'Obfuscation',
    description: 'A proxy wey dem design to disguise your traffic as normal HTTPS. E no be full VPN protocol, but people dey often use am where standard VPNs dey blocked.',
    bestFor: 'Networks wey dem block everything',
  },
  {
    name: 'V2Ray',
    badge: 'Advanced obfuscation',
    description: 'Flexible tool wey fit disguise VPN traffic in plenty ways. E dey more complex to set up, but e effective for regions with deep packet inspection.',
    bestFor: 'Countries wey dey actively block VPN',
  },
];

const faqs = [
  { question: 'Which protocol I go use by default?', answer: 'Start with WireGuard if your VPN offer am. E be the fastest and e dey work well for streaming, browsing, and mobile data. Only switch to OpenVPN (UDP) if WireGuard block or unreliable on your network.' },
  { question: 'Wetin be the difference between Shadowsocks and VPN?', answer: 'Shadowsocks na proxy wey dey encrypt your traffic and disguise am as HTTPS, but e no dey encrypt all your device traffic the way full VPN dey do. Dem mainly dey use am to pass blocking, no be for general privacy.' },
  { question: 'V2Ray better pass Shadowsocks?', answer: 'V2Ray dey more flexible and fit disguise traffic in more ways, but e dey harder to set up. For most people for restricted regions, Shadowsocks simpler and e dey often enough. V2Ray worth trying if Shadowsocks stop to work.' },
  { question: 'Why WireGuard sometimes no dey connect?', answer: 'Some networks and countries dey actively block WireGuard traffic because e packets get recognizable pattern. If this happen, switch to OpenVPN (TCP) or try obfuscation tool like Shadowsocks if your provider support am.' },
];

const tags = ['protocols', 'WireGuard', 'OpenVPN', 'V2Ray', 'Shadowsocks', 'guide'];

const hreflang = [
  { lang: 'en', url: 'https://www.topvpn.top/connection-guide' },
  { lang: 'ar', url: 'https://www.topvpn.top/ar/connection-guide' },
  { lang: 'pcm', url: 'https://www.topvpn.top/pcm/connection-guide' },
  { lang: 'x-default', url: 'https://www.topvpn.top/connection-guide' },
];
---

<BaseLayout
  title="VPN Protocols Explained: WireGuard, OpenVPN, V2Ray, Shadowsocks"
  description="Simple guide to VPN protocols — which one to use for streaming, gaming, and restricted networks. Plus country-by-country overview."
  lang="pcm"
  hreflang={hreflang}
  autolink={false}
  ogLocale="pcm_NG"
  jsonLd={contextWrapper(breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Connection Guide' }]))}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Connection Guide' }]} />

  <section class="container-max py-8 md:py-12">
    <div class="max-w-3xl">
      <div class="mb-4 flex items-center gap-2 text-xs" style="color: var(--color-muted-dark);">
        <Icons name="doc" size={14} />
        <span>Updated {updatedStr}</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">
        VPN Protocols <span class="gold-text">Explained</span>: WireGuard, OpenVPN, V2Ray, Shadowsocks
      </h1>

      <p class="text-base md:text-lg mb-4" style="color: var(--color-muted);">
        VPN protocol na the method wey your VPN dey use to encrypt and route your traffic. The right choice dey affect speed, reliability, and whether your connection go work for restricted regions. Most people suppose to use WireGuard; people inside heavily filtered networks fit need Shadowsocks or V2Ray.
      </p>

      <div class="card p-4 mb-6 text-sm" style="background: var(--color-bg-alt);">
        <p style="color: var(--color-muted);"><strong style="color: var(--color-text);">Quick answer:</strong> Use WireGuard for speed and everyday browsing. Use OpenVPN (UDP) as fallback. Use OpenVPN (TCP), Shadowsocks, or V2Ray for countries or networks wey dey block standard VPN traffic. VPN laws dey different by country — check local rules before you use am.</p>
      </div>

      <TagChips chips={tags} class="mb-6" />
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Which Protocol for Which Situation</h2>
    <div class="overflow-x-auto mb-8">
      <table class="responsive-table w-full text-sm" style="border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--color-border);">
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Situation</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Recommended</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Why</th>
          </tr>
        </thead>
        <tbody>
          {protocolSituations.map((row, i) => (
            <tr style={i < protocolSituations.length - 1 ? 'border-bottom: 1px solid var(--color-border);' : ''}>
              <td data-label="Situation" class="py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">{row.situation}</td>
              <td data-label="Recommended" class="py-3 px-2 md:px-4" style="color: var(--color-gold-light); font-weight: 600;">{row.recommendation}</td>
              <td data-label="Why" class="py-3 px-2 md:px-4" style="color: var(--color-muted);">{row.reason}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Protocols Wey Dey Often Work Better by Country</h2>
    <p class="text-sm mb-4 max-w-3xl" style="color: var(--color-muted);">
      This table base on general experience, no be guarantee. Protocol effectiveness dey change as time dey go and filtering methods dey evolve. "Often works well" mean say users dey frequently report success; "may be blocked" mean say e fit fail or dem go throttle am.
    </p>
    <div class="overflow-x-auto mb-8">
      <table class="responsive-table w-full text-sm" style="border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--color-border);">
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Country</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Internet users</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Often works well</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">May be blocked</th>
            <th class="text-left py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">Notes</th>
          </tr>
        </thead>
        <tbody>
          {countryProtocols.map((row, i) => (
            <tr style={i < countryProtocols.length - 1 ? 'border-bottom: 1px solid var(--color-border);' : ''}>
              <td data-label="Country" class="py-3 px-2 md:px-4 font-semibold" style="color: var(--color-text);">{row.country}</td>
              <td data-label="Internet users" class="py-3 px-2 md:px-4" style="color: var(--color-muted);">{row.pop}</td>
              <td data-label="Often works well" class="py-3 px-2 md:px-4" style="color: var(--color-emerald); font-weight: 600;">{row.oftenWorks}</td>
              <td data-label="May be blocked" class="py-3 px-2 md:px-4" style="color: var(--color-muted-dark);">{row.mayBeBlocked}</td>
              <td data-label="Notes" class="py-3 px-2 md:px-4" style="color: var(--color-muted);">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Protocol Breakdown</h2>
    <div class="space-y-4 mb-8">
      {protocols.map((p) => (
        <div class="card p-5">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-bold" style="font-family: var(--font-heading);">{p.name}</h3>
            <span class="text-xs px-2 py-1 rounded" style="background: rgba(212, 175, 55, 0.1); color: var(--color-gold-light);">{p.badge}</span>
          </div>
          <p class="text-sm mb-2" style="color: var(--color-muted);">{p.description}</p>
          <p class="text-xs mb-3" style="color: var(--color-muted-dark);">Best for: {p.bestFor}</p>
          <a href="/order-vpn" class="inline-flex items-center gap-1 text-xs font-semibold gold-text">
            See VPN plans wey support {p.name}
            <Icons name="arrow-right" size={14} class="text-amber-400" />
          </a>
        </div>
      ))}
    </div>

    <div class="my-10">
      <NewsiqAd placement={newsiqInline} id="newsiq-guide-connections-pcm" />
    </div>

    <div class="max-w-3xl mb-8">
      <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">FAQ</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-4 group">
            <summary class="font-semibold cursor-pointer text-sm flex items-center justify-between" style="font-family: var(--font-heading);">
              {f.question}
              <Icons name="chevron-down" size={16} class="text-amber-400 transition-transform group-open:rotate-180" />
            </summary>
            <p class="text-sm mt-3" style="color: var(--color-muted);">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>

    <h2 class="text-2xl font-bold mb-4" style="font-family: var(--font-heading);">Related Guides</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl">
      <a href="/vpn-types-guide" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">Dedicated vs Shared IP</h3>
        <p class="text-xs" style="color: var(--color-muted);">Which IP type fit your needs for banking, streaming, and work</p>
      </a>
      <a href="/order-vpn" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">Compare VPN Plans</h3>
        <p class="text-xs" style="color: var(--color-muted);">Price and protocol support side-by-side for every provider</p>
      </a>
      <a href="/" class="card p-4 block transition-all hover:border-amber-400">
        <h3 class="text-sm font-bold mb-1" style="font-family: var(--font-heading);">TopVPN Home</h3>
        <p class="text-xs" style="color: var(--color-muted);">Our top picks and wetin make dem stand out</p>
      </a>
    </div>
  </section>
</BaseLayout>
