---
import BaseLayout from '../layouts/BaseLayout.astro';
import PremiumPlans from '../components/PremiumPlans.astro';
import PureVPNAlternative from '../components/PureVPNAlternative.astro';
import FAQ from '../components/FAQ.astro';
import Icons from '../components/Icons.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsiqCardsGrid from '../components/newsiq/NewsiqCardsGrid.astro';
import { getCollection } from 'astro:content';
import { orgSchema, websiteSchema, faqSchema, contextWrapper, breadcrumbSchema } from '../lib/schema';

// hreflang: the Arabic homepage pairs with the English one. x-default points to
// English (the site's default/global version).
const hreflang = [
  { lang: 'en', url: 'https://www.topvpn.top/' },
  { lang: 'ar', url: 'https://www.topvpn.top/ar' },
  { lang: 'pcm', url: 'https://www.topvpn.top/pcm' },
  { lang: 'x-default', url: 'https://www.topvpn.top/' },
];

// Guides shown on the homepage: the three most recently updated published articles.
const guides = (await getCollection('articlesAr', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime())
  .slice(0, 3);

const valueProps = [
  { icon: 'dollar', title: 'أسعار في متناول الجميع', text: 'خدمة في بي ان متميزة بسعر يحترم ميزانيتك — من $9 للشهر الواحد، مع أسعار شهرية أدنى في الفترات الأطول.' },
  { icon: 'globe', title: 'خبرة تزيد عن عشر سنوات', text: 'نحن في مجال الـ VPN منذ أكثر من عشر سنوات، بدءًا من GoldenVPN. تلك الخبرة تُشكل كل ما نبنيه اليوم.' },
  { icon: 'list', title: 'شفافية في الأسعار', text: 'باقات واضحة وأرقام صادقة. السعر الذي تراه هو السعر الذي تدفعه — لا ضغوط مصطنعة، ولا خصومات وهمية.' },
  { icon: 'shield', title: 'صدق حتى لو لم يصب في مصلحتنا', text: 'لا يوجد في بي ان مثالي في كل الحالات، ولن نتظاهر بذلك. نقول لك الحقيقة كما هي.' },
];

const criteria = [
  { icon: 'shield', title: 'الخصوصية والأمان', text: 'سياسة الاحتفاظ بالسجلات، قوة التشفير، المراجعة المستقلة، والجهة القضائية التي تخضع لها الشركة.' },
  { icon: 'gauge', title: 'السرعة والثبات', text: 'مدى ثبات الاتصال وسرعة التنفيذ، سواء من الخوادم القريبة أو البعيدة.' },
  { icon: 'globe', title: 'تغطية الخوادم والوصول', text: 'عدد الدول المتاحة، خيارات البروتوكولات، ومدى العمل في المناطق التي تفرض حجبًا.' },
  { icon: 'devices', title: 'القيمة وسهولة الاستخدام', text: 'أسعار حقيقية على شهر و٦ أشهر وسنة، تطبيقات لأجهزتك، ودعم فني متاح.' },
];

const explore = [
  { href: '/ar/vpn-types-guide', title: 'IP مخصص مقابل IP مشترك', text: 'أيّهما يناسب البث المباشر والعمل من المنزل.' },
  { href: '/ar/connection-guide', title: 'البروتوكولات ببساطة', text: 'WireGuard وOpenVPN وV2Ray وShadowsocks بكلمات واضحة.' },
  { href: '/ar/apps', title: 'تطبيقات لكل جهاز', text: 'ويندوز، ماك، لينكس، أندرويد، آيفون، وأجهزة الراوتر.' },
  { href: '/ar/articles', title: 'أدلة حسب الدولة', text: 'لماذا يستخدم الناس في بي ان في كل دولة، وما الذي يجب أن تنظر إليه.' },
];

const whyUseVpn = [
  { icon: 'wifi', title: 'حماية على الواي فاي العام', text: 'شّفّر اتصالك في المقاهي والمطار والفنادق بحيث لا يستطيع أحد اعتراض بياناتك.' },
  { icon: 'globe', title: 'الوصول أثناء السفر', text: 'احصل على خدماتك ومحتواك المفضلين بأمان، حتى عندما تحجبها القيود الجغرافية خارج بلدك.' },
  { icon: 'eye', title: 'تجنب التتبع', text: 'منع مزودي الإنترنت والإعلانات والأطراف الثالثة من مراقبة نشاط تصفحك.' },
  { icon: 'padlock', title: 'فتح المواقع المحجوبة', text: 'تجاوز الحجب والوصول إلى المواقع والخدمات التي لا تتوفر في منطقتك — بما في ذلك تطبيقات المكالمات الصوتية.' },
];

const faqs = [
  { question: 'ما هو TopVPN Premium؟', answer: 'TopVPN Premium هو خدمة الـ VPN الخاصة بنا: تجربة في بي ان متميزة بسعر في متناول الجميع. إنها ثمرة أكثر من عشر سنوات من العمل في سوق الـ VPN — أولًا باسم GoldenVPN، واليوم باسم TopVPN.' },
  { question: 'كم تكلفة TopVPN Premium؟', answer: 'ثلاث فترات دفعة واحدة: الشهرية بـ $9 للشهر الواحد — والشهر الأول كعميل جديد بـ $3 بدلًا من $9. السنوية بـ $72 مقابل 12 شهرًا ($6 شهريًا). السنتين بـ $120 مقابل 24 شهرًا ($5 شهريًا). لا يوجد تجديد تلقائي.' },
  { question: 'كيف أشتري TopVPN Premium؟', answer: 'أنشئ حسابك في /account، اختر باقة في قسم شراء في بي ان، وادفع لمرة واحدة عبر Stripe أو PayPal. يُعدّ حساب الـ VPN الخاص بك تلقائيًا بعد الدفع، وتفاصيل الاتصال تظهر في قسم خدمات الـ VPN الخاصة بي.' },
  { question: 'ما هو في بي ان ولماذا أحتاج إليه؟', answer: 'الـ VPN (شبكة افتراضية خاصة) يشفّر اتصالك بالإنترنت ويمرّره عبر خادم بعيد، فيخفي عنوان IP ويحمي بياناتك من الاعتراض. تحتاج إليه للحماية على الواي فاي العام، وفتح المحتوى المحجوبة الجغرافي، وتجنب التتبع من مزودي الخدمة والإعلانات.' },
  { question: 'هل يبطئ في بي ان سرعة الإنترنت؟', answer: 'يضيف الـ VPN كمية صغيرة من الحمل الإضافي لأن يُشفّر ويُمرّر عبر خادم إضافي. خدمات الـ VPN الجيدة تقلل هذا التأثير، وقد يُحسّن الـ VPN السرعة أحيانًا إذا كان مزود الإنترنت يبطئ أنواعًا معينة من المرور.' },
  { question: 'هل يمكنني استخدام في بي ان على أكثر من جهاز؟', answer: 'تسمح معظم خدمات الـ VPN بعدة اتصالات متزامنة على اشتراك واحد. العدد الدقيق يختلف، لذا تحقق من تفاصيل الباقة قبل الشراء.' },
  { question: 'هل في بي ان المجاني أفضل؟ ماذا يجب أن أعرف؟', answer: 'توجد خطط مجانية لدى بعض المزودين مثل Proton VPN، لكنها غالبًا محدودة السرعة أو عدد الخوادم. أما خدمات في بي ان المجانية غير المعروفة فقد تبيع بياناتك أو تعرضك للإعلانات. للخصوصية والسرعة الحقيقية، نوصي بخدمة مدفوعة موثوقة بسياسة عدم الاحتفاظ بالسجلات.' },
  { question: 'هل استخدام في بي ان قانوني؟', answer: 'نعم، استخدام في بي ان قانوني في معظم دول العالم. لكن بعض الدول تفرض قيودًا على استخدامه — خاصة في الشرق الأوسط وشمال أفريقيا. تحقق دائمًا من القوانين المحلية في بلدك قبل الاستخدام، وخصوصًا عند السفر.' },
];

// Product/AggregateOffer rich result — Arabic copy for the Arabic homepage.
const premiumProductSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'TopVPN Premium',
  description: 'خدمة في بي ان متميزة بأسعار لمرة واحدة: $3 للشهر الأول للعملاء الجدد، $9 شهريًا، $72 سنويًا أو $120 لسنتين. بدون اشتراك وبدون تجديد تلقائي.',
  brand: { '@type': 'Brand', name: 'TopVPN' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '3.00',
    highPrice: '120.00',
    offerCount: '3',
    offers: [
      { '@type': 'Offer', name: 'الشهرية (الشهر الأول للعملاء الجدد)', price: '3.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://www.topvpn.top/ar#plans' },
      { '@type': 'Offer', name: 'السنوية — 12 شهرًا', price: '72.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://www.topvpn.top/ar#plans' },
      { '@type': 'Offer', name: 'السنتين — 24 شهرًا (أفضل قيمة)', price: '120.00', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://www.topvpn.top/ar#plans' },
    ],
  },
};
---

<BaseLayout
  title="افضل في بي ان بسعر عادل — باقات تبدأ من $3 للشهر الأول"
  description="اشترِ في بي ان متميز بسعر صادق: $3 للشهر الأول، ثم من $5.00 شهريًا في باقة السنتين. دفع لمرة واحدة فقط — بدون اشتراك، بدون تجديد تلقائي. أكثر من 10 سنوات في مجال الـ VPN."
  lang="ar"
  dir="rtl"
  hreflang={hreflang}
  autolink={false}
  ogLocale="ar_AR"
  jsonLd={contextWrapper([orgSchema, websiteSchema, breadcrumbSchema([{ label: 'الرئيسية', href: '/' }]), premiumProductSchema, faqSchema(faqs)])}
>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: var(--color-bg);">
    <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 70% 55% at 50% 0%, rgba(212, 175, 55, 0.14), transparent);"></div>

    <div class="container-max relative pt-14 pb-16 md:pt-24 md:pb-24">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-6 rounded-full" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.28);">
          <Icons name="check" size={14} />
          <span class="text-xs font-semibold" style="color: var(--color-emerald);">أسعار واضحة. بدون مبالغة. بدون رسوم مخفية.</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-5">
          <span class="gold-text">خدمة في بي ان متميزة</span> بسعر في متناول الجميع
        </h1>

        <p class="text-base md:text-lg mb-8 max-w-2xl mx-auto" style="color: var(--color-muted);">
          احصل على الخصوصية والأمان والحرية التي تقدمها خدمة في بي ان متميزة، دون أن تدفع ثمنًا باهظًا.
          خدمة واحدة واضحة، ثلاث باقات بسيطة، وفريق يعمل في مجال الـ VPN منذ أكثر من عقد.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-3">
          <a href="#plans" class="btn-gold w-full sm:w-auto">
            شاهد باقاتنا
            <Icons name="arrow-left" size={18} />
          </a>
          <a href="/ar/about" class="btn-outline w-full sm:w-auto">اقرأ قصتنا</a>
        </div>
        <p class="text-xs" style="color: var(--color-muted-dark);">
          الشهر الأول بـ <strong style="color: var(--color-text);">$3</strong> للعملاء الجدد. باقة السنتين: فقط <strong style="color: var(--color-text);">$5.00 شهريًا</strong>. دفع لمرة واحدة — بدون اشتراك.
        </p>
      </div>
    </div>
    <div class="divider-gold"></div>
  </section>

  <!-- Value proposition -->
  <section class="container-max py-12 md:py-16">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">لماذا TopVPN Premium</h2>
      <p class="text-base max-w-2xl mx-auto" style="color: var(--color-muted);">
        لا ينبغي أن يكلفك الـ VPN المتميز ثمنًا باهظًا. هذا هو ما نعدك به، وهذا هو ما نرفض فعله.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {valueProps.map((item) => (
        <div class="card card-hover p-6">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg mb-3" style="background: rgba(212, 175, 55, 0.1);">
            <Icons name={item.icon} size={22} class="text-amber-400" />
          </div>
          <h3 class="text-base font-bold mb-1">{item.title}</h3>
          <p class="text-sm" style="color: var(--color-muted);">{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Primary product: TopVPN Premium plans -->
  <PremiumPlans locale="ar" />

  <!-- Separate affiliate alternative (PureVPN) — kept below our own plans -->
  <PureVPNAlternative locale="ar" />

  <AdSlot />

  <!-- Educational content (evergreen SEO) -->
  <section class="py-12 md:py-16" style="background: var(--color-bg-alt);">
    <div class="container-max">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-2">لماذا تستخدم في بي ان؟</h2>
        <p class="text-sm" style="color: var(--color-muted);">ثلاثة أسباب تجعل ملايين الناس يعتمدون على الـ VPN كل يوم.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {whyUseVpn.map((item) => (
          <div class="card p-6 text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-4" style="background: rgba(212, 175, 55, 0.1);">
              <Icons name={item.icon} size={24} class="text-amber-400" />
            </div>
            <h3 class="text-lg font-bold mb-2">{item.title}</h3>
            <p class="text-sm" style="color: var(--color-muted);">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What to look for (educational, provider-agnostic) -->
  <section class="py-12 md:py-16" style="background: var(--color-bg-alt);">
    <div class="container-max">
      <div class="text-center mb-10">
        <span class="eyebrow">ما يهم حقًا</span>
        <h2 class="section-title">ماذا تبحث عنه في خدمة في بي ان جيدة</h2>
        <p class="section-sub">سواء اخترتنا أو مزودًا آخر، هذه هي العوامل التي تحدث فرقًا فعليًا.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {criteria.map((c) => (
          <div class="card card-hover p-5">
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg mb-3" style="background: rgba(212, 175, 55, 0.1);">
              <Icons name={c.icon} size={22} class="text-amber-400" />
            </div>
            <h3 class="text-base font-bold mb-1">{c.title}</h3>
            <p class="text-sm" style="color: var(--color-muted);">{c.text}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/ar/about" class="btn-outline">اقرأ نهجنا الكامل</a>
      </div>
    </div>
  </section>

  <!-- Sponsored placements (NEWSIQ), kept distinct from editorial -->
  <section class="container-max py-12 md:py-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold" style="font-family: var(--font-heading);">شريك مميز</h2>
      <span class="text-xs uppercase tracking-wide" style="color: var(--color-muted-dark);">مُموّل</span>
    </div>
    <NewsiqCardsGrid id="newsiq-home-cards" />
  </section>

  <!-- Guides / internal links (SEO) -->
  <section class="container-max py-12 md:py-16">
    <div class="text-center mb-10">
      <span class="eyebrow">أدلة</span>
      <h2 class="section-title">تعلم قبل أن تشتري</h2>
      <p class="section-sub">أدلة قصيرة وعملية حول الأسئلة التي يبحث عنها الناس فعليًا.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {explore.map((g) => (
        <a href={g.href} class="card card-hover p-5 block">
          <h3 class="text-base font-bold mb-1" style="color: var(--color-text);">{g.title}</h3>
          <p class="text-sm mb-3" style="color: var(--color-muted);">{g.text}</p>
          <span class="text-xs font-semibold gold-text">اقرأ الدليل</span>
        </a>
      ))}
    </div>

    <p class="text-center text-sm mt-6" style="color: var(--color-muted);">
      تفضل مقارنة مزودي الخدمة المشهورين؟
      <a href="/ar/order-vpn" class="underline gold-text">شاهد مقارنة الـ VPN الكاملة لدينا</a>.
    </p>

    {guides.length > 0 && (
      <div class="mt-10">
        <h3 class="text-lg font-bold mb-4">أحدث المقالات</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {guides.map((a) => (
            <a href={`/ar/articles/${a.id}`} class="card card-hover p-5 block">
              <h4 class="text-base font-bold mb-1" style="color: var(--color-text);">{a.data.title}</h4>
              <p class="text-sm" style="color: var(--color-muted);">{a.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="container-max py-12 md:py-16" id="faq">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 text-center">الأسئلة الشائعة</h2>
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="py-16 md:py-20" style="background: var(--color-bg-alt);">
    <div class="container-max text-center">
      <h2 class="text-2xl md:text-4xl font-bold mb-4">
        جاهز لـ <span class="gold-text">في بي ان متميز</span> يكلف أقل؟
      </h2>
      <p class="text-base mb-8 max-w-xl mx-auto" style="color: var(--color-muted);">
        ثلاث فترات دفع لمرة واحدة فقط. فواتير شفافة. ابدأ من $9 لشهر واحد.
      </p>
      <a href="#plans" class="btn-gold">
        شاهد باقاتنا
        <Icons name="arrow-left" size={18} />
      </a>
    </div>
  </section>

  <div class="container-max py-4" style="color: var(--color-muted-dark); font-size: 12px;">Impact-Site-Verification: 33745c1e-8e03-4098-9528-5f1270b4d320</div>
</BaseLayout>