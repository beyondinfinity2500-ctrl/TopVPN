const countries = [...new Set(servers.map(s => s.country))].sort();

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'VPN Servers' }];
---

<BaseLayout
  title="VPN Server Locations | TopVPN"
  description="Browse TopVPN's available VPN server locations worldwide. WireGuard and VLESS servers across 50+ countries."
  hreflang={[{ lang: 'en', url: 'https://www.topvpn.top/vpn-servers' }]}
  jsonLd={contextWrapper([breadcrumbSchema(breadcrumbItems)])}
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="container-max py-10 md:py-14">
    <h1 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">VPN Server Locations</h1>
    <p class="text-base max-w-2xl mb-8" style="color: var(--color-muted);">
      Available server locations for TopVPN Premium. All servers are provided by our VPN infrastructure partner.
      Connection details are delivered securely through your customer account after purchase.
    </p>

    <div class="mb-6">
      <p class="text-sm" style="color: var(--color-muted);">
        <strong>{servers.length}</strong> servers across <strong>{countries.length}</strong> countries/regions.
      </p>
    </div>

    {countries.map(country => (
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-heading);">{country}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" style="border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid var(--color-border);">
                <th class="text-left py-2 px-3" style="color: var(--color-muted);">City</th>
                <th class="text-left py-2 px-3" style="color: var(--color-muted);">Protocol</th>
                <th class="text-left py-2 px-3" style="color: var(--color-muted);">Status</th>
              </tr>
            </thead>
            <tbody>
              {servers.filter(s => s.country === country).map(s => (
                <tr style="border-bottom: 1px solid var(--color-border);">
                  <td class="py-2 px-3">{s.city}</td>
                  <td class="py-2 px-3">{s.protocol}</td>
                  <td class="py-2 px-3" style="color: var(--color-emerald);">Available</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
